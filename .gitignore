# ---- checkpoints ------------------------------------------------------------
# Model trees are tens of GiB; they never belong in git. The GUI and the serve
# launchers discover whatever is under models/ at runtime.
models/

# ---- vendored toolchain / downloads ----------------------------------------
# The Zig 0.17 aarch64-windows toolchain (~380 MB) lives in tools/ so the build
# is reproducible on this box, but it is a download, not source.
tools/
downloads/
.venv/
venv/

# ---- build output -----------------------------------------------------------
zig-out/
.zig-cache/
*.exe
*.pdb
*.obj
*.o
*.lib
*.bmp
*.res

# ---- analysis / recovery scratch -------------------------------------------
# .acl-recovery holds the backup and undo command from a Windows file-permission
# repair; .analysis holds throwaway diffs, patches and commit lists from an
# audit. Both are local working notes, never source.
.acl-recovery/
.analysis/

# ---- runtime output ---------------------------------------------------------
logs/
*.log

# ---- machine-specific config -----------------------------------------------
# gui/models.json holds absolute checkpoint paths and per-model launch settings;
# it is regenerated from the model folder when missing.
gui/models.json
# settings.json is the chosen skin; it is a local preference, not source.
settings.json

# ---- misc -------------------------------------------------------------------
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
